# Which model provider to use: google, groq, nvidia (free tiers), mistral (paid API),
# or openai_compatible (any service speaking the OpenAI API: set OPENAI_COMPATIBLE_BASE_URL and LLM_MODEL).
LLM_PROVIDER=google

# Only the key of the chosen provider is needed. Real keys go in .env, never in this file.
GOOGLE_API_KEY=your-key-here
GROQ_API_KEY=your-key-here
MISTRAL_API_KEY=your-key-here
NVIDIA_API_KEY=your-key-here
# OPENAI_COMPATIBLE_API_KEY=your-key-here
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1

# Optional: another model, or slower calls if you hit rate limits.
# LLM_MODEL=gemini-flash-latest
# LLM_REQUESTS_PER_SECOND=0.15

# Optional: LangSmith tracing (https://smith.langchain.com). Every run of the agent then appears
# as a trace: each model call, each tool, inputs, outputs, tokens, time. Off when commented out.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-key-here
# LANGSMITH_PROJECT=control-tower-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your LangSmith account is in the EU region

# Optional: reasoning models (e.g. the NVIDIA default) think before answering. Off by default: faster.
# LLM_REASONING=on
# LLM_MAX_TOKENS=3000
